# Optional. Override the canonical public origin used for absolute URLs at runtime.
# Production default when unset: https://riffsync.tv (`.forge/project.json` → `public_domain`).
# Staging: set to the CloudFront / staging hostname when building that artifact.
# VITE_PUBLIC_ORIGIN=https://staging.example.com

# Required for production builds: AWS API Gateway HTTP API origin (no trailing slash required).
# CI sets this from CloudFormation output `HttpApiUrl` on `RiffSyncApi-{staging|prod}` after deploy.
# Example: https://abcd1234.execute-api.us-east-1.amazonaws.com
# VITE_PUBLIC_API_BASE_URL=

# Local development: copy to `.env.development` and point at a deployed staging API or mock.
# Without `VITE_PUBLIC_API_BASE_URL`, `vite dev` loads `data/catalog/episodes.json` as a fallback only.
