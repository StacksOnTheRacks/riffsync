{
  "name": "@riffsync/infra-cdk",
  "private": true,
  "version": "0.0.0",
  "description": "RiffSync AWS CDK (TypeScript) — staging/prod static hosting baseline",
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build -w",
    "cdk": "cdk",
    "synth:staging": "cdk synth --all --context environment=staging",
    "synth:prod": "cdk synth --all --context environment=prod",
    "test": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "aws-cdk": "^2.173.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.173.4",
    "constructs": "^10.4.2"
  }
}
